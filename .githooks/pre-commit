#!/usr/bin/env bash
# ============================================================================
# pre-commit: защита от утечки секретов в git
# Установлен после инцидента 08.08.2026 (угон токена Telegram-бота из
# публичного .env.example на GitHub).
# Блокирует коммит, если в изменениях найдены реальные секреты.
# Обход (только осознанно): git commit --no-verify
# ============================================================================

set -uo pipefail

RED='\033[0;31m'; YEL='\033[1;33m'; NC='\033[0m'
FAIL=0

# Файлы, попадающие в коммит (без удалённых)
FILES=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$FILES" ] && exit 0

fail() {
    printf "${RED}✖ БЛОКИРОВКА КОММИТА:${NC} %s\n" "$1" >&2
    FAIL=1
}

# --- 1. Сам файл .env и его варианты не должны попадать в git ------------------
while IFS= read -r f; do
    case "$(basename "$f")" in
        .env|.env.local|.env.bak|.env.backup*|.env.prod|.env.production)
            fail "попытка закоммитить файл секретов: $f"
            ;;
    esac
done <<< "$FILES"

# --- 2. Токен Telegram-бота в любом файле -------------------------------------
# Формат: 8-10 цифр, двоеточие, 35 символов [A-Za-z0-9_-]
TG_RE='[0-9]{8,10}:AA[A-Za-z0-9_-]{30,}'
HITS=$(git diff --cached -U0 -- $(printf '%s\n' "$FILES" | tr '\n' ' ') 2>/dev/null \
       | grep -E '^\+' | grep -vE '^\+\+\+' | grep -oE "$TG_RE" | sort -u)
if [ -n "$HITS" ]; then
    fail "в коммите найден токен Telegram-бота:"
    printf '%s\n' "$HITS" | sed -E 's/(:AA.{0,4}).*/\1***** (замаскировано)/' >&2
fi

# --- 3. Пароли/секреты с реальными значениями ---------------------------------
# Ищем PASSWORD=/SECRET=/TOKEN=/API_KEY= со значением, которое НЕ является
# плейсхолдером. Плейсхолдеры разрешены: your_, change, example, <...>, xxx, ***
SECRET_LINES=$(git diff --cached -U0 -- $(printf '%s\n' "$FILES" | tr '\n' ' ') 2>/dev/null \
    | grep -E '^\+' | grep -vE '^\+\+\+' \
    | grep -iE '(password|secret_key|secret|api_key|apikey|access_token|private_key)[[:space:]]*[=:][[:space:]]*"?[A-Za-z0-9_@!$%^&*-]{8,}' \
    | grep -viE 'your_|change_?me|changeme|example|placeholder|<[^>]+>|xxx|\*\*\*|dummy|sample|test_?password|\$\{|os\.getenv|getenv|environ|settings\.|config\.|localStorage|process\.env|=\s*""|:\s*""')
if [ -n "$SECRET_LINES" ]; then
    fail "в коммите найдены строки с похожими на реальные паролями/секретами:"
    printf '%s\n' "$SECRET_LINES" | head -10 | sed -E 's/([=:][[:space:]]*"?.{0,4}).*/\1***** (замаскировано)/' >&2
fi

# --- 4. Приватные ключи --------------------------------------------------------
KEY_HITS=$(git diff --cached -U0 -- $(printf '%s\n' "$FILES" | tr '\n' ' ') 2>/dev/null \
    | grep -E '^\+' | grep -cE 'BEGIN (RSA|OPENSSH|DSA|EC|PGP) PRIVATE KEY')
if [ "${KEY_HITS:-0}" -gt 0 ]; then
    fail "в коммите найден приватный ключ (BEGIN ... PRIVATE KEY)"
fi

if [ "$FAIL" -ne 0 ]; then
    printf "\n${YEL}Как исправить:${NC}\n" >&2
    printf "  1. Уберите секрет из файла, замените плейсхолдером (например <DB_PASSWORD из .env>)\n" >&2
    printf "  2. Реальные значения храните ТОЛЬКО в .env (он в .gitignore)\n" >&2
    printf "  3. Если секрет уже был запушен — считайте его скомпрометированным и ротируйте\n" >&2
    printf "  4. Осознанный обход проверки: ${YEL}git commit --no-verify${NC}\n\n" >&2
    exit 1
fi

exit 0
