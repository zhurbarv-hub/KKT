FROM nginx:alpine

# Copy built frontend
COPY web-new/dist /usr/share/nginx/html

# Copy nginx config for SPA
RUN echo 'server {     listen 80;     root /usr/share/nginx/html;     index index.html;     location / {         try_files $uri $uri/ /index.html;     }     location /assets/ {         expires 1y;         add_header Cache-Control "public, immutable";     } }' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
